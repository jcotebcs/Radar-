# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Notion Integration
NOTION_API_KEY=your_notion_api_key_here

# Square Integration
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_APPLICATION_ID=your_square_application_id_here
SQUARE_ENVIRONMENT=sandbox

# Session Secret
SESSION_SECRET=your_random_session_secret_here

# Google API Keys (optional - for additional Google services)
# Format: SERVICE_NAME_KEY=your_api_key
# Examples:
# YOUTUBE_DATA_API_V3_KEY=your_youtube_api_key
# GOOGLE_CALENDAR_API_KEY=your_calendar_api_key
# GMAIL_API_KEY=your_gmail_api_key
# GOOGLE_DRIVE_API_KEY=your_drive_api_key