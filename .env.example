# Radar Notes Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# HTTPS Configuration
HTTPS_ENABLED=false
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# Security
SESSION_SECRET=your-session-secret-here
CORS_ORIGIN=https://yourdomain.com

# Google API Keys (optional)
# Set any Google API keys using the format: API_NAME_KEY
# Example:
# YOUTUBE_DATA_API_V3_KEY=your-youtube-api-key
# GOOGLE_CALENDAR_API_KEY=your-calendar-api-key
# GOOGLE_CLOUD_STORAGE_KEY=your-storage-api-key

# Monitoring & Logging
LOG_LEVEL=info
LOG_FILE=logs/radar-notes.log
HEALTH_CHECK_ENABLED=true

# Database (for future persistence)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=radar_notes
# DB_USER=radar_user
# DB_PASSWORD=your-db-password

# Redis (for session storage and caching)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Performance
COMPRESSION_ENABLED=true
CACHE_MAX_AGE=31536000
STATIC_CACHE_ENABLED=true