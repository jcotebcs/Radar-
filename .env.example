# Google API Keys Configuration
# Set environment variables for the Google APIs you want to use
# Follow the pattern: SERVICE_NAME_API_KEY=your_api_key_here

# Common APIs for Radar Notes functionality:
YOUTUBE_DATA_API_V3_KEY=
GOOGLE_CALENDAR_API_KEY=
GMAIL_API_KEY=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DOCS_API_KEY=
GOOGLE_SHEETS_API_KEY=
GOOGLE_TASKS_API_KEY=
CLOUD_SPEECH_TO_TEXT_API_KEY=
CLOUD_TRANSLATION_API_KEY=
CLOUD_STORAGE_API_KEY=
GEOLOCATION_API_KEY=
MAPS_JAVASCRIPT_API_KEY=
PLACES_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# SSL Configuration (for production)
SSL_KEY_PATH=
SSL_CERT_PATH=
HTTPS_PORT=443

# Data Backup Configuration
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30